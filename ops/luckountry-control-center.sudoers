# Only this fixed, root-owned wrapper may be run by the service account.
luckountry ALL=(root) NOPASSWD: /usr/local/libexec/luckountry-smart-status
luckountry ALL=(root) NOPASSWD: /usr/local/libexec/lcc-tx-maintenance TX_LCC_DEPLOY_DISABLED knys/luckountry-control-center
luckountry ALL=(root) NOPASSWD: /usr/local/libexec/lcc-tx-maintenance TX_LCC_RESTART knys/luckountry-control-center
