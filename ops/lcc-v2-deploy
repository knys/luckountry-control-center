#!/bin/sh
set -eu

# Root-owned, fixed self-deployment entrypoint. The only accepted input is the
# exact GitHub main commit; no command, path, or sudo option is caller supplied.
test "$#" -eq 1 || { echo "usage: lcc-v2-deploy MAIN_SHA" >&2; exit 64; }
revision=$1
case "$revision" in *[!0-9a-f]*|"") echo "invalid revision" >&2; exit 64;; esac
test "${#revision}" -eq 40 || { echo "invalid revision" >&2; exit 64; }
test "$(id -u)" -eq 0 || { echo "root required" >&2; exit 77; }
if test "${LCC_V2_DETACHED_DEPLOY:-}" != 1; then
  exec /usr/bin/systemd-run --quiet --wait --collect --unit="lcc-v2-deploy-$revision" --setenv=LCC_V2_DETACHED_DEPLOY=1 /usr/local/sbin/lcc-v2-deploy "$revision"
fi

root=/opt/luckountry-control-center-v2
source_dir=$root/source
release=$root/releases/$revision
previous=$(readlink -f "$root/current" 2>/dev/null || true)
backup=$root/backups/$(date -u +%Y%m%dT%H%M%SZ)-$revision
install -d -o root -g root -m 0755 "$root/releases" "$root/backups" "$backup"
test -z "$previous" || printf '%s\n' "$previous" > "$backup/previous-release"

if test ! -d "$source_dir/.git"; then
  /usr/bin/git clone --no-checkout -- https://github.com/knys/luckountry-control-center.git "$source_dir"
fi
/usr/bin/git -C "$source_dir" fetch --force origin main
remote=$(/usr/bin/git -C "$source_dir" rev-parse origin/main)
test "$remote" = "$revision" || { echo "requested SHA is not GitHub main" >&2; exit 65; }
/usr/bin/git -C "$source_dir" reset --hard "$revision"
/usr/bin/git -C "$source_dir" clean -ffd
/usr/bin/npm --prefix "$source_dir" ci
/usr/bin/npm --prefix "$source_dir" test
/usr/bin/npm --prefix "$source_dir" run build
install -d -o root -g root -m 0755 "$release"
cp -a "$source_dir/dist" "$release/"
printf '%s\n' "$revision" > "$release/REVISION"
test -f "$release/dist/config/products.json"

runuser -u user -- env HOST=127.0.0.1 PORT=3001 LCC_RELEASE_SHA="$revision" LCC_V2_DATA_DIRECTORY="/tmp/lcc-v2-canary-$revision" LCC_PRODUCTS_MANIFEST="$release/dist/config/products.json" /usr/bin/node "$release/dist/v2/server.js" &
canary=$!
trap 'kill "$canary" 2>/dev/null || true' EXIT
i=0
until /usr/bin/curl -fsS http://127.0.0.1:3001/health >/dev/null; do
  i=$((i+1)); test "$i" -lt 30 || { echo "canary health failed" >&2; exit 1; }
  sleep 1
done
kill "$canary" 2>/dev/null || true
wait "$canary" 2>/dev/null || true
trap - EXIT

ln -sfn "$release" "$root/current.next"
mv -Tf "$root/current.next" "$root/current"
if ! systemctl restart luckountry-control-center-v2.service; then
  test -z "$previous" || ln -sfn "$previous" "$root/current"
  systemctl restart luckountry-control-center-v2.service || true
  echo "restart failed; rolled back" >&2
  exit 1
fi
i=0
until /usr/bin/curl -fsS http://127.0.0.1:3000/health >/dev/null; do
  i=$((i+1))
  if test "$i" -ge 30; then
    test -z "$previous" || ln -sfn "$previous" "$root/current"
    systemctl restart luckountry-control-center-v2.service || true
    echo "production health failed; rolled back" >&2
    exit 1
  fi
  sleep 1
done
echo "deployed $revision; backup $backup"
