[Unit]
Description=Luckountry Independent Self-Commissioning Watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=user
SupplementaryGroups=luckountry
WorkingDirectory=/opt/luckountry-control-center
EnvironmentFile=-/etc/luckountry-control-center/environment
EnvironmentFile=-/etc/luckountry-control-center/self-commissioning
RuntimeDirectory=luckountry-self-commissioning-watchdog
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/flock -n /run/luckountry-self-commissioning-watchdog/single-flight.lock /usr/bin/node /opt/luckountry-control-center/dist/application/self-commissioning-watchdog-cli.js
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/luckountry-control-center
RestrictSUIDSGID=true
LockPersonality=true
TimeoutStartSec=20min
