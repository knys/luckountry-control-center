[Unit]
Description=Luckountry Persistent Commission Watcher
After=network-online.target luckountry-control-center.service
[Service]
Type=simple
User=user
WorkingDirectory=/home/user/.lcc-commission-watcher/workspace
Environment=COMMISSION_INBOX_PATH=/var/lib/luckountry-control-center/commissions.json
Environment=COMMISSION_WATCHER_STATUS_PATH=/var/lib/luckountry-control-center/watcher.json
Environment=LCC_WORKSPACE=/home/user/.lcc-commission-watcher/workspace
ExecStart=/usr/bin/node /opt/luckountry-control-center/dist/application/commission-watcher.js
Restart=always
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
